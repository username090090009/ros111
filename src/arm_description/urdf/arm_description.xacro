      </geometry>
      <material name="tcp_red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="spray_tcp_joint" type="fixed">
    <parent link="spray_gun_link"/>
    <child link="spray_tcp_link"/>
    
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
  </joint>

  <!-- RGB-D camera -->
  <link name="rgbd_camera_link">
    <visual>
