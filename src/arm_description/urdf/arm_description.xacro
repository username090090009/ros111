  </link>

  <!-- spray_gun -->
  <joint name="spray_gun_joint" type="fixed">
    <parent link="spray_gun_mount_link"/>
    <child link="spray_gun_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- spray_tcp -->
  <link name="spray_tcp_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
