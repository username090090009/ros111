<?xml version="1.0"?>
<!--
  curved_spray_demo.launch — Curved-surface spray trajectory planning demo
  =========================================================================
  Launches the complete curved-surface spray workflow:
    1. Gazebo + MoveIt execution pipeline
    2. Curved-surface spray trajectory planning node

  Usage:
    roslaunch arm_description_moveit_config curved_spray_demo.launch

  Key parameters:
    band_spacing           : Band spacing in meters (smaller = denser coverage, default 0.03)
    sample_step            : In-band sample step in meters (default 0.02)
    standoff_distance      : Spray gun standoff from surface in meters (default 0.18)
    flip_normals           : Flip surface normals (true/false, default false)
    auto_execute           : Auto-execute after planning (true/false, default true)
    orientation_tolerance  : Max orientation relaxation in radians (default 0.15)
    allow_spray_door_collision : Allow spray gun / door near-surface contact (default true)

  If the door outer surface faces the wrong direction, set flip_normals to true.

  Note: Door pose parameters (door_x/y/z, door_yaw, etc.) must match the URDF
  values in arm_description.xacro world_to_door_joint.
-->
<launch>

  <!-- ===== Top-level switches ===== -->
  <arg name="paused"      default="false"  doc="Start Gazebo paused"/>
  <arg name="gazebo_gui"  default="true"   doc="Show Gazebo GUI"/>
  <arg name="use_rviz"    default="true"   doc="Launch RViz"/>
  <arg name="pipeline"    default="ompl"   doc="MoveIt planning pipeline"/>
  <arg name="debug"       default="false"  doc="MoveIt debug mode"/>

  <!-- ===== Spray planning parameters ===== -->
  <arg name="band_spacing"      default="0.03"  doc="Band spacing (m)"/>
  <arg name="sample_step"       default="0.02"  doc="In-band sample step (m)"/>
  <arg name="standoff_distance" default="0.18"  doc="Standoff distance (m)"/>
  <arg name="flip_normals"      default="false" doc="Flip surface normals"/>
  <arg name="auto_execute"      default="true"  doc="Auto-execute trajectory"/>
  <arg name="visualize"         default="true"  doc="Publish RViz visualization"/>

  <!-- ===== IK and execution parameters ===== -->
  <arg name="orientation_tolerance"  default="0.15"  doc="Orientation relaxation tolerance (rad)"/>
  <arg name="ik_check_timeout"       default="0.05"  doc="IK solver timeout for pre-check (s)"/>
  <arg name="relaxation_attempts"    default="6"     doc="Number of orientation relaxation attempts"/>
  <arg name="min_segment_size"       default="3"     doc="Minimum waypoints per executable segment"/>
  <arg name="allow_spray_door_collision" default="true" doc="Allow spray gun / door collision"/>

  <!-- ===== 1. Gazebo + MoveIt execution pipeline ===== -->
  <include file="$(find arm_description_moveit_config)/launch/gazebo_spray.launch">
    <arg name="paused"     value="$(arg paused)"/>
    <arg name="gazebo_gui" value="$(arg gazebo_gui)"/>
    <arg name="use_rviz"   value="$(arg use_rviz)"/>
    <arg name="pipeline"   value="$(arg pipeline)"/>
    <arg name="debug"      value="$(arg debug)"/>
  </include>

  <!-- ===== 2. Curved-surface spray planning node ===== -->
  <node name="curved_surface_spray_node" pkg="arm_perception"
        type="curved_surface_spray_node" output="screen">
    <!-- Door pose (must match URDF world_to_door_joint) -->
    <param name="door_x"   value="0.90"/>
    <param name="door_y"   value="0.00"/>
    <param name="door_z"   value="0.50"/>
    <param name="door_roll" value="0.0"/>
    <param name="door_pitch" value="0.0"/>
    <param name="door_yaw"  value="1.5708"/>

    <!-- Mesh offset (must match door.xacro) -->
    <param name="mesh_offset_x" value="-2.035"/>
    <param name="mesh_offset_y" value="0.669"/>
    <param name="mesh_offset_z" value="-0.925"/>

    <!-- Spray planning parameters -->
    <param name="band_spacing"      value="$(arg band_spacing)"/>
    <param name="sample_step"       value="$(arg sample_step)"/>
    <param name="standoff_distance" value="$(arg standoff_distance)"/>
    <param name="flip_normals"      value="$(arg flip_normals)"/>
    <param name="auto_execute"      value="$(arg auto_execute)"/>
    <param name="visualize"         value="$(arg visualize)"/>

    <!-- Cartesian path parameters -->
    <param name="eef_step"                value="0.01"/>
    <param name="min_cartesian_fraction"  value="0.70"/>

    <!-- IK and execution parameters -->
    <param name="orientation_tolerance"  value="$(arg orientation_tolerance)"/>
    <param name="ik_check_timeout"       value="$(arg ik_check_timeout)"/>
    <param name="relaxation_attempts"    value="$(arg relaxation_attempts)"/>
    <param name="min_segment_size"       value="$(arg min_segment_size)"/>
    <param name="allow_spray_door_collision" value="$(arg allow_spray_door_collision)"/>
  </node>

</launch>
